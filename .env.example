# Copy to .env and fill in real values. Never commit .env.

# --- Database (docker compose) -------------------------------------------------
SIGNALPOST_DB_PASSWORD=change-me

# --- Spring Boot backend -------------------------------------------------------
SIGNALPOST_BACKEND_PORT=8080

# OAuth login (Google and/or GitHub). Required by docker compose.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/login/oauth2/code/github

# JWT signing secret (at least 32 random characters).
JWT_SECRET=
JWT_ISSUER=prativ-api
JWT_AUDIENCE=prativ-api
JWT_LIFETIME=PT15M

# Cookies must be secure in production.
SESSION_COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
APP_FRONTEND_URL=http://localhost:3000

# --- Agent (FastAPI) -----------------------------------------------------------
# Run-wide Brreg request cap and politeness throttle.
SIGNALPOST_REQUEST_CAP=1900
# Browser origins allowed to call the agent API cross-origin (comma separated).
# Leave empty unless a browser must call the agent directly.
SIGNALPOST_ALLOWED_ORIGINS=
# Per-client request budget for the HTTP API.
SIGNALPOST_RATE_LIMIT_PER_MIN=300
